# The "Ask about me" search (/api/ask) needs one provider key. Server-side only.
# If both are set, Groq wins — override with ASK_PROVIDER=anthropic.

GROQ_API_KEY=gsk_...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional — force a provider: "groq" or "anthropic"
# ASK_PROVIDER=groq

# Optional — override the model for whichever provider is active.
# Groq default:      openai/gpt-oss-120b   (also: openai/gpt-oss-20b)
# Anthropic default: claude-opus-5         (also: claude-sonnet-5, claude-haiku-4-5)
# ASK_MODEL=openai/gpt-oss-120b
